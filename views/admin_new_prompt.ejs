<%- include('partials/header') %>

<div class="container" style="padding-top:40px;padding-bottom:60px;max-width:850px;">

    <a href="/admin" class="back-link">← Back to Admin Dashboard</a>

    <h1 class="section-title" style="margin-top:16px;">Add New Master Prompt</h1>
    <p class="section-sub">Publish a new viral AI video prompt to the library</p>

    <div style="background:#fff;border-radius:var(--radius);padding:30px;border:1.5px solid var(--border);box-shadow:var(--shadow-sm);margin-top:20px;">
        <form method="post" action="/admin/new-prompt" enctype="multipart/form-data">
            
            <div class="fld">
                <label style="font-weight:700;font-size:14px;">Prompt Title</label>
                <input type="text" name="title" required placeholder="e.g. WILD RESCUE ENGINE — MASTER PROMPT v1.0" style="font-weight:600;font-size:15px;">
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="fld">
                    <label style="font-weight:700;font-size:14px;">Category</label>
                    <select name="category" required style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;background:#fff;font-family:inherit;font-size:14px;">
                        <option value="Animal & Pets">Animal &amp; Pets</option>
                        <option value="Art & Animation">Art &amp; Animation</option>
                        <option value="ASMR & Satisfying">ASMR &amp; Satisfying</option>
                        <option value="Comedy & Entertainment">Comedy &amp; Entertainment</option>
                        <option value="DIY & Crafts">DIY &amp; Crafts</option>
                        <option value="Emotional & Inspirational">Emotional &amp; Inspirational</option>
                        <option value="Fantasy & Sci-Fi">Fantasy &amp; Sci-Fi</option>
                        <option value="Food & Cooking">Food &amp; Cooking</option>
                        <option value="Historical & Nostalgia">Historical &amp; Nostalgia</option>
                        <option value="Kids & Family">Kids &amp; Family</option>
                        <option value="Nature & Wildlife">Nature &amp; Wildlife</option>
                        <option value="Sports & Action">Sports &amp; Action</option>
                        <option value="General" selected>General</option>
                    </select>
                </div>
                <div class="fld">
                    <label style="font-weight:700;font-size:14px;">Type / Access Level</label>
                    <select name="type" required style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:12px;background:#fff;font-family:inherit;font-size:14px;">
                        <option value="premium" selected>⭐ Premium (Subscribers only)</option>
                        <option value="free">🎁 Free (Public / Logged-in Free users)</option>
                    </select>
                </div>
            </div>

            <div class="fld">
                <label style="font-weight:700;font-size:14px;">Thumbnail Storyboard Image (Choose File)</label>
                <input type="file" name="image_file" accept="image/*" required style="width:100%;padding:10px 14px;border:1.5px dashed var(--border);border-radius:12px;background:#f8fafc;cursor:pointer;">
            </div>

            <div class="fld" style="margin-top:20px;">
                <label style="display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:14px;">
                    <span>Master Prompt</span>
                    <span style="font-size:12px;font-weight:normal;color:var(--muted);">Pure black text on white background</span>
                </label>
                <textarea name="master_prompt" rows="18" required placeholder="Paste full master prompt instructions here..." style="font-family:'Inter', system-ui, sans-serif;font-size:14px;line-height:1.75;padding:16px;width:100%;border-radius:12px;border:1.5px solid var(--border);"></textarea>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:30px;padding-top:20px;border-top:1px solid var(--border);">
                <a href="/admin" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary btn-lg" style="padding:12px 32px;font-size:15px;font-weight:700;">Publish Prompt</button>
            </div>

        </form>
    </div>

</div>

<%- include('partials/footer') %>
