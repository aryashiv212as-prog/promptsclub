<%- include('partials/header') %>

<div class="prompt-single">
    <a href="/browse.php" class="back-link">← Back to all prompts</a>

    <div class="prompt-head">
        <h1><%= prompt.title %></h1>
        <div class="prompt-meta">
            <span>📂 <%= prompt.category %></span>
            <span>🕒 Updated <%= prompt.created_at || 'Recent' %></span>
            <% if (prompt.type === 'free') { %>
                <span class="badge-free">FREE</span>
            <% } else { %>
                <span class="badge-pro">⭐ PREMIUM</span>
            <% } %>
        </div>
    </div>

    <!-- Main Visual Thumbnail (Cinema Frame) -->
    <div style="margin: 24px 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 20px 45px rgba(0,0,0,0.6); background: #000; position: relative; border: 1px solid var(--border-subtle);">
        <img src="<%= prompt.image %>" alt="<%= prompt.title %>" class="lb-img" style="width: 100%; max-height: 480px; object-fit: cover; display: block; cursor: zoom-in;" onerror="this.src='/assets/img/cover.jpg'">
        <div style="position:absolute; bottom:16px; left:16px; background:rgba(10,13,20,0.85); backdrop-filter:blur(8px); padding:6px 14px; border-radius:var(--radius-full); font-size:12px; font-weight:700; color:var(--cyan-light); border:1px solid rgba(255,255,255,0.1);">
            🎬 4K Storyboard Reference Frame · Click to Enlarge
        </div>
    </div>

    <% 
    const isFree = prompt.type === 'free';
    const isPro = currentUser && currentUser.is_pro;
    const canView = isPro || isFree;
    %>

    <% if (!canView) { %>
        <!-- Locked State -->
        <div style="background:var(--bg-card); border:1.5px solid rgba(99,102,241,0.35); border-radius:var(--radius-lg); padding:32px; box-shadow:var(--shadow-md); margin-top:24px;">
            <div style="font-size:15px; color:var(--text); line-height:1.7; margin-bottom:28px; padding-bottom:24px; border-bottom:1px solid var(--border-subtle);">
                <%= prompt.teaser || "This premium prompt includes the complete master prompt system — full scene structure, camera angles, timing breakdown, captions, viral hooks and reference storyboard images. Everything is ready to copy and paste into your AI video tool. Members get instant access to this and every other prompt in the library, plus all new weekly drops." %>
            </div>
            <div style="text-align:center; padding:10px 0;">
                <div style="font-size:44px; margin-bottom:12px;">🔒</div>
                <h3 style="font-size:24px; margin-bottom:8px;">Member Exclusive Prompt</h3>
                <p style="color:var(--text-muted); font-size:14.5px; max-width:480px; margin:0 auto 24px;">Unlock this full prompt, camera angles, DaVinci grade, and all master prompts in the library.</p>
                <div style="display:flex; justify-content:center; gap:14px; flex-wrap:wrap;">
                    <a href="/pricing.php" class="btn btn-primary btn-lg">
                        💳 Pay on Website — $<%= (typeof settings !== 'undefined' && settings.price_monthly) ? settings.price_monthly : 10 %>/mo
                    </a>
                    <a href="https://wa.me/919341266089?text=<%= encodeURIComponent('Hi! I want to unlock Master Prompt #' + prompt.id + ' (' + prompt.title + ') on PromptsClub. Please send payment details (UPI / Bank Transfer / Card / Any).') %>" 
                       target="_blank" rel="noopener" class="btn btn-green btn-lg" style="background:#22C55E; color:#FFFFFF; gap:8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.1 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.79h-.01a9.72 9.72 0 0 1-4.96-1.36l-.36-.21-3.69.97.98-3.6-.23-.37a9.72 9.72 0 0 1-1.49-5.18c0-5.37 4.37-9.74 9.75-9.74a9.68 9.68 0 0 1 6.89 2.86 9.68 9.68 0 0 1 2.85 6.89c0 5.38-4.37 9.74-9.73 9.74zm8.28-18.02A11.64 11.64 0 0 0 12.05.33C5.6.33.35 5.58.35 12.03c0 2.06.54 4.07 1.56 5.84L.25 23.79l6.07-1.59a11.68 11.68 0 0 0 5.72 1.46h.01c6.45 0 11.7-5.25 11.7-11.7 0-3.13-1.22-6.07-3.42-8.19z"/></svg>
                        <span>Buy via WhatsApp (All Payment Methods)</span>
                    </a>
                </div>
                <% if (!currentUser) { %>
                    <p style="margin-top:14px; font-size:13px; color:var(--text-muted);">
                        Already a member? <a href="/login.php?next=<%= encodeURIComponent('/prompt.php?id=' + prompt.id) %>">Login here</a>
                    </p>
                <% } %>
            </div>
        </div>

    <% } else { %>
        <!-- Soni Prompts Unlocked Master Prompt State -->
        <div class="prompt-box-unlocked" style="background:transparent; border:none; padding:0; box-shadow:none; margin-top:20px;">
            <div class="copy-bar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:10px;">
                <div>
                    <span style="font-size:14px; font-weight:700; color:#111827; text-transform:uppercase; letter-spacing:0.04em;">📋 Master Prompt System</span>
                </div>
                <div style="display:flex; gap:10px; align-items:center;">
                    <button type="button" class="btn btn-primary" id="copy-btn" style="padding:9px 20px; font-size:14px; font-weight:700; border-radius:10px;">
                        📋 Copy Prompt
                    </button>
                    <% if (currentUser) { %>
                        <button type="button" class="btn btn-outline btn-sm" id="bookmark-btn" data-id="<%= prompt.id %>" onclick="toggleBookmark(this.getAttribute('data-id'))">
                            <%= (currentUser.bookmarks && currentUser.bookmarks.includes(prompt.id)) ? '❤️ Saved' : '🤍 Bookmark' %>
                        </button>
                    <% } %>
                </div>
            </div>

            <!-- Master Prompt Content in Pure White Box with Crisp Black Text -->
            <div class="prompt-content" id="prompt-content" style="background:#FFFFFF !important; color:#000000 !important; border:1.5px solid var(--border); border-radius:var(--radius); box-shadow:0 1px 4px rgba(0,0,0,0.05); padding:28px 30px; font-size:15px; line-height:1.85; white-space:pre-wrap; word-wrap:break-word; word-break:break-word; font-family:'Inter', system-ui, -apple-system, sans-serif !important; font-weight:450;"><%= prompt.master_prompt %></div>

            <!-- Pro Upgrade Banner on Free Prompt for Non-Pro Visitors -->
            <% if (isFree && (!currentUser || !currentUser.is_pro)) { %>
                <div style="margin-top:24px; padding:20px; background:#EEF2FF; border:1.5px solid #C7D2FE; border-radius:12px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                    <div>
                        <strong style="color:#3730A3; font-size:15px;">🎁 Liked this Free Master Prompt?</strong>
                        <p style="color:#4338CA; font-size:13.5px; margin:2px 0 0;">Unlock all 19 other master prompts with camera angles, pacing &amp; weekly drops.</p>
                    </div>
                    <a href="/pricing.php" class="btn btn-primary btn-sm">Get Pro Access — $<%= (typeof settings !== 'undefined' && settings.price_monthly) ? settings.price_monthly : 10 %>/mo</a>
                </div>
            <% } %>

            <!-- Compatible Tools & Tags -->
            <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--border);">
                <h4 style="font-size:14px;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;">Recommended AI Engines</h4>
                <div>
                    <% if (prompt.compatible_tools && prompt.compatible_tools.length) { %>
                        <% prompt.compatible_tools.forEach(function(tool) { %>
                            <span class="tool-tag"><%= tool %></span>
                        <% }); %>
                    <% } else { %>
                        <span class="tool-tag">Kling AI 1.5</span>
                        <span class="tool-tag">Runway Gen-3</span>
                        <span class="tool-tag">Seedance</span>
                        <span class="tool-tag">Luma Dream Machine</span>
                    <% } %>
                </div>

                <h4 style="font-size:14px;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;margin-top:16px;margin-bottom:10px;">Keywords &amp; Niches</h4>
                <div>
                    <% if (prompt.tags && prompt.tags.length) { %>
                        <% prompt.tags.forEach(function(tag) { %>
                            <span style="display:inline-block;background:#f3f4f6;color:#374151;font-size:12px;padding:4px 9px;border-radius:6px;margin-right:6px;margin-bottom:6px;">#<%= tag %></span>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>

        <script>
        function toggleBookmark(id) {
            const btn = document.getElementById('bookmark-btn');
            fetch('/api/bookmark.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id })
            }).then(r => r.json()).then(res => {
                if (res.saved) {
                    btn.textContent = '❤️ Saved';
                } else {
                    btn.textContent = '🤍 Bookmark';
                }
            }).catch(e => console.error(e));
        }
        </script>
    <% } %>

</div>

<!-- Lightbox Modal -->
<div id="lightbox" class="modal-overlay">
    <div style="max-width:90vw;max-height:90vh;position:relative;">
        <img src="" alt="Enlarged Storyboard" style="max-width:100%;max-height:85vh;border-radius:12px;box-shadow:0 20px 50px rgba(0,0,0,0.5);">
        <p style="text-align:center;color:#fff;margin-top:10px;font-size:14px;">Click anywhere to close</p>
    </div>
</div>

<%- include('partials/footer') %>
