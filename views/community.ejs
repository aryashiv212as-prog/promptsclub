<%- include('partials/header') %>

<div class="community-wrap" style="max-width:800px;margin:0 auto;padding:40px 20px 80px;">

    <span class="section-tag">💬 CREATOR LOUNGE</span>
    <h1 style="font-size:36px; margin:10px 0 6px;">Creator Lounge</h1>
    <p style="color:var(--text-muted); font-size:15px; margin-bottom:32px;">Share your AI video results, workflows &amp; viral reel prompts 🚀</p>

    <!-- Post Composer or Guest Banner -->
    <% if (currentUser) { %>
        <% if (currentUser.is_pro || currentUser.role === 'admin') { %>
            <div class="cpost" style="border: 1.5px solid rgba(99,102,241,0.35); background: var(--bg-card); box-shadow:0 10px 30px rgba(0,0,0,0.5);">
                <form method="post" action="/community.php/create" enctype="multipart/form-data">
                    <div style="display:flex;gap:12px;margin-bottom:12px;">
                        <span class="cpost-avatar" style="background:var(--primary);color:#fff;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;"><%= currentUser.name.charAt(0).toUpperCase() %></span>
                        <div style="flex:1;">
                            <strong style="color:#fff;"><%= currentUser.name %></strong>
                            <% if (currentUser.role === 'admin') { %>
                                <span class="cpost-admin-badge" style="background:rgba(99,102,241,0.2);color:var(--cyan-light);padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;">Host ✔</span>
                            <% } else { %>
                                <span class="badge-pro" style="font-size:10px;">PRO MEMBER</span>
                            <% } %>
                        </div>
                    </div>
                    <textarea name="text" rows="3" placeholder="Share a prompt tip, video workflow, or result..." required style="width:100%;border:1px solid var(--border-subtle);background:rgba(10,13,20,0.85);color:#fff;border-radius:12px;padding:12px 14px;font-family:inherit;font-size:14.5px;resize:vertical;"></textarea>
                    
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;flex-wrap:wrap;gap:10px;">
                        <label class="btn btn-outline btn-sm" style="cursor:pointer;margin:0;">
                            📎 Add Media / Storyboard
                            <input type="file" name="attachment" accept="image/*,video/*" style="display:none;" onchange="this.nextElementSibling.textContent = this.files[0] ? '✓ ' + this.files[0].name : '';">
                            <span class="attach-name" style="margin-left:6px;color:var(--primary);font-weight:600;"></span>
                        </label>
                        <button type="submit" class="btn btn-primary btn-sm">Post to Community</button>
                    </div>
                </form>
            </div>
        <% } else { %>
            <div class="mem-banner">
                <span>👋 Free members can like posts. Upgrade to PRO to publish posts &amp; video breakdowns!</span>
                <a href="/pricing.php" class="btn">Join PRO — $10/mo</a>
            </div>
        <% } %>
    <% } else { %>
        <div class="mem-banner">
            <span>👋 Login to like posts — join premium to post &amp; comment.</span>
            <a href="/login.php?next=/community.php" class="btn">Login Free</a>
        </div>
    <% } %>

    <!-- Feed -->
    <% posts.forEach(function(post) { %>
        <div class="cpost" id="post-<%= post.id %>">
            <div class="cpost-head">
                <span class="cpost-avatar"><%= post.author_avatar || post.author_name.charAt(0).toUpperCase() %></span>
                <div>
                    <strong><%= post.author_name %></strong>
                    <% if (post.is_creator) { %>
                        <span class="cpost-admin-badge">Creator ✔</span>
                    <% } %>
                    <div class="cpost-time"><%= post.created_at %></div>
                </div>
            </div>

            <div class="cpost-text">
                <%- post.text.replace(/\n/g, '<br>') %>
            </div>

            <% if (post.image_url) { %>
                <div style="margin-top:14px;border-radius:12px;overflow:hidden;">
                    <img src="<%= post.image_url %>" alt="" style="max-width:100%;border-radius:12px;display:block;">
                </div>
            <% } %>

            <div class="cpost-actions">
                <form method="post" action="/community.php/like" style="display:inline;">
                    <input type="hidden" name="post_id" value="<%= post.id %>">
                    <button type="submit" class="cact <%= (currentUser && post.liked_by && post.liked_by.includes(currentUser.id)) ? 'liked' : '' %>">
                        <%= (currentUser && post.liked_by && post.liked_by.includes(currentUser.id)) ? '❤️' : '🤍' %> <%= post.likes || 0 %>
                    </button>
                </form>
                <button type="button" class="cact" onclick="var c=document.getElementById('comments-<%= post.id %>'); c.style.display = c.style.display === 'none' ? 'block' : 'none';">
                    💬 <%= post.comments ? post.comments.length : 0 %>
                </button>
                <button type="button" class="cact share-btn" data-link="https://promptsclub.com/community.php?post=<%= post.id %>">
                    🔗 Share
                </button>
            </div>

            <div class="cpost-comments" id="comments-<%= post.id %>" style="display:none;margin-top:14px;padding-top:14px;border-top:1px solid var(--border);">
                <% if (post.comments && post.comments.length) { %>
                    <% post.comments.forEach(function(comment) { %>
                        <div class="ccomment" style="margin-bottom:10px;">
                            <strong><%= comment.author %></strong>
                            <span><%= comment.text %></span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="font-size:13px;color:var(--muted);margin-bottom:10px;">No comments yet. Be the first to reply!</p>
                <% } %>

                <% if (currentUser) { %>
                    <form method="post" action="/community.php/comment" style="display:flex;gap:8px;margin-top:10px;">
                        <input type="hidden" name="post_id" value="<%= post.id %>">
                        <input type="text" name="comment_text" placeholder="Write a reply…" required style="flex:1;border:1.5px solid var(--border);border-radius:999px;padding:8px 16px;font-size:13.5px;font-family:inherit;">
                        <button type="submit" class="btn btn-sm btn-primary">Reply</button>
                    </form>
                <% } else { %>
                    <p style="font-size:13px;color:var(--muted);"><a href="/login.php?next=/community.php">Login</a> to comment.</p>
                <% } %>
            </div>
        </div>
    <% }); %>

</div>

<%- include('partials/footer') %>
