<%- include('partials/header') %>

<div class="container" style="padding-top:40px; padding-bottom:60px; text-align:center;">

    <span class="pill" style="background:var(--primary-light); color:var(--primary); font-weight:700; border-color:rgba(99,102,241,0.3);">💎 PRO MEMBERSHIP</span>
    <h1 style="font-size:36px; margin:14px 0 8px;">Upgrade to PromptsClub Pro</h1>
    <p style="color:var(--text-muted); font-size:15.5px; margin-bottom:36px;">Instant access to all <%= totalPrompts %> viral master prompts, scene breakdowns &amp; weekly drops.</p>

    <!-- PRO FEATURES SUMMARY -->
    <div style="max-width:760px; margin:0 auto 36px; background:#FFFFFF; border:1.5px solid var(--border-subtle); border-radius:var(--radius-lg); padding:24px 30px; box-shadow:var(--shadow-sm); text-align:left;">
        <h3 style="font-size:17px; margin-bottom:12px; color:var(--text);">What You Get with Pro:</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:10px; font-size:14px; color:var(--text);">
            <div>✅ <strong>All <%= totalPrompts %> Master Prompts</strong> Unlocked</div>
            <div>✅ <strong>Complete 4-Scene Breakdown</strong> (0-30s)</div>
            <div>✅ <strong>Camera Specs &amp; Motion Controls</strong></div>
            <div>✅ <strong>Kling, Runway, Seedance, Luma</strong> Ready</div>
            <div>✅ <strong>1-Click Instant Copy</strong> Prompt Text</div>
            <div>✅ <strong>Weekly New Viral Prompts</strong> Added</div>
        </div>
    </div>

    <!-- DUAL PAYMENT OPTIONS: PAY ON WEBSITE vs PURCHASE THROUGH WHATSAPP -->
    <div style="max-width:880px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit, minmax(340px, 1fr)); gap:24px; text-align:left;">

        <!-- OPTION 1: PAY ON WEBSITE (PAYPAL & CARDS) -->
        <div style="background:#FFFFFF; border:2px solid var(--primary); border-radius:var(--radius-lg); padding:30px; box-shadow:var(--shadow-md); display:flex; flex-direction:column; position:relative;">
            <div style="position:absolute; top:-12px; right:20px; background:var(--primary); color:#FFFFFF; font-size:11px; font-weight:800; padding:3px 12px; border-radius:999px; text-transform:uppercase; letter-spacing:0.04em;">
                Instant Access
            </div>

            <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                <span style="font-size:24px;">💳</span>
                <div>
                    <h3 style="font-size:20px; margin:0;">Option 1: Pay on Website</h3>
                    <span style="font-size:13px; color:var(--text-muted);">PayPal, Debit Card, Credit Card</span>
                </div>
            </div>

            <div style="margin:16px 0 20px;">
                <span style="font-size:36px; font-weight:800; color:var(--text);"><%= (typeof settings !== 'undefined' && settings.price_currency) ? settings.price_currency : '$' %><%= (typeof settings !== 'undefined' && settings.price_monthly) ? settings.price_monthly : 10 %></span>
                <span style="color:var(--text-muted); font-size:15px; font-weight:600;">/month</span>
                <p style="font-size:13px; color:var(--green); font-weight:600; margin-top:4px;">⚡ Instant automatic activation upon checkout</p>
            </div>

            <div style="flex:1;">
                <% if (!currentUser) { %>
                    <a href="/register.php?next=/pricing.php" class="btn btn-primary btn-block btn-lg" style="margin-bottom:10px;">
                        Sign In / Register to Pay
                    </a>
                    <p style="font-size:12.5px; color:var(--text-muted); text-align:center;">
                        Create account in 10 seconds so Pro access links to your email.
                    </p>
                <% } else if (currentUser.is_pro) { %>
                    <div style="background:#ECFDF5; border:1.5px solid #A7F3D0; color:#065F46; padding:14px; border-radius:10px; text-align:center; font-weight:700;">
                        🎉 PRO ACTIVE — You already have full access!
                    </div>
                <% } else { %>
                    <div id="paypal-button-container" style="min-height:50px;"></div>
                    <div id="paypal-loader" style="text-align:center; font-size:13px; color:var(--text-muted); padding:8px;">Loading PayPal buttons…</div>

                    <div style="margin-top:14px; text-align:center;">
                        <button type="button" id="pay-btn" class="btn btn-outline btn-block btn-sm" onclick="activateDemoProSubscription()">
                            ⚡ Instant Test Mode Activation
                        </button>
                    </div>
                    <p id="pay-msg" style="display:none; text-align:center; margin-top:10px; font-size:13.5px; font-weight:600;"></p>
                <% } %>
            </div>
        </div>

        <!-- OPTION 2: PURCHASE THROUGH WHATSAPP (ALL PAYMENT METHODS ACCEPTED) -->
        <div style="background:#FFFFFF; border:2px solid #22C55E; border-radius:var(--radius-lg); padding:30px; box-shadow:var(--shadow-md); display:flex; flex-direction:column; position:relative;">
            <div style="position:absolute; top:-12px; right:20px; background:#22C55E; color:#FFFFFF; font-size:11px; font-weight:800; padding:3px 12px; border-radius:999px; text-transform:uppercase; letter-spacing:0.04em;">
                All Payment Methods
            </div>

            <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                <span style="font-size:24px;">🟢</span>
                <div>
                    <h3 style="font-size:20px; margin:0;">Option 2: Buy on WhatsApp</h3>
                    <span style="font-size:13px; color:var(--text-muted);">UPI, GPay, PhonePe, Paytm, Bank Transfer, Cards &amp; More</span>
                </div>
            </div>

            <div style="margin:16px 0 20px;">
                <span style="font-size:36px; font-weight:800; color:var(--text);">₹<%= (typeof settings !== 'undefined' && settings.price_inr) ? settings.price_inr : 899 %></span>
                <span style="color:var(--text-muted); font-size:15px; font-weight:600;">(or $<%= (typeof settings !== 'undefined' && settings.price_monthly) ? settings.price_monthly : 10 %> USD)</span>
                <p style="font-size:13px; color:var(--green); font-weight:600; margin-top:4px;">💬 WhatsApp: <strong>9341266089</strong> (Active Now)</p>
            </div>

            <div style="background:#F0FDF4; border:1px solid #BBF7D0; border-radius:10px; padding:14px; font-size:13px; color:#166534; margin-bottom:20px;">
                <strong>All Payment Modes Accepted on WhatsApp:</strong>
                <ul style="margin:6px 0 0 18px; padding:0; line-height:1.5;">
                    <li><strong>UPI &amp; QR:</strong> PhonePe, Google Pay, Paytm, BHIM</li>
                    <li><strong>Bank Transfer:</strong> IMPS / NEFT / RTGS Direct Transfer</li>
                    <li><strong>Cards &amp; Other:</strong> Debit/Credit Card, International, PayPal</li>
                    <li>Send your email on WhatsApp for <strong>instant Pro unlock</strong>!</li>
                </ul>
            </div>

            <div style="margin-top:auto;">
                <a href="https://wa.me/919341266089?text=<%= encodeURIComponent('Hi! I want to purchase PromptsClub Pro Membership (₹' + ((typeof settings !== 'undefined' && settings.price_inr) ? settings.price_inr : 899) + ' / $' + ((typeof settings !== 'undefined' && settings.price_monthly) ? settings.price_monthly : 10) + '). Please send payment details (UPI / Bank Transfer / Card / Any). My account email is: ' + (currentUser ? currentUser.email : '')) %>" 
                   target="_blank" rel="noopener" class="btn btn-green btn-block btn-lg" style="background:#22C55E; color:#FFFFFF; gap:8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.21 5.1 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.79h-.01a9.72 9.72 0 0 1-4.96-1.36l-.36-.21-3.69.97.98-3.6-.23-.37a9.72 9.72 0 0 1-1.49-5.18c0-5.37 4.37-9.74 9.75-9.74a9.68 9.68 0 0 1 6.89 2.86 9.68 9.68 0 0 1 2.85 6.89c0 5.38-4.37 9.74-9.73 9.74zm8.28-18.02A11.64 11.64 0 0 0 12.05.33C5.6.33.35 5.58.35 12.03c0 2.06.54 4.07 1.56 5.84L.25 23.79l6.07-1.59a11.68 11.68 0 0 0 5.72 1.46h.01c6.45 0 11.7-5.25 11.7-11.7 0-3.13-1.22-6.07-3.42-8.19z"/></svg>
                    <span>Buy via WhatsApp (All Payment Methods) →</span>
                </a>
            </div>
        </div>

    </div>

    <!-- Trust Badges -->
    <div style="display:flex; justify-content:center; gap:24px; flex-wrap:wrap; margin-top:40px;">
        <div style="font-size:13.5px; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
            <span>🔐</span> <strong>Encrypted Checkout</strong>
        </div>
        <div style="font-size:13.5px; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
            <span>⚡</span> <strong>Instant Access</strong>
        </div>
        <div style="font-size:13.5px; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
            <span>💬</span> <strong>WhatsApp Help: 9341266089</strong>
        </div>
    </div>

</div>

<% if (currentUser && !currentUser.is_pro) { %>
<!-- Official PayPal SDK -->
<script src="https://www.paypal.com/sdk/js?client-id=<%= (typeof settings !== 'undefined' && settings.paypal_client_id) ? settings.paypal_client_id : 'sb' %>&currency=<%= (typeof settings !== 'undefined' && settings.paypal_currency) ? settings.paypal_currency : 'USD' %>"></script>

<script>
if (window.paypal) {
    const loader = document.getElementById('paypal-loader');
    if (loader) loader.style.display = 'none';

    paypal.Buttons({
        style: {
            layout: 'vertical',
            color: 'gold',
            shape: 'rect',
            label: 'paypal',
            height: 44
        },
        createOrder: function(data, actions) {
            return actions.order.create({
                purchase_units: [{
                    description: "PromptsClub Pro Access (promptsclub.com)",
                    amount: {
                        currency_code: "<%= (typeof settings !== 'undefined' && settings.paypal_currency) ? settings.paypal_currency : 'USD' %>",
                        value: "<%= (typeof settings !== 'undefined' && settings.price_monthly) ? settings.price_monthly : '10' %>"
                    }
                }]
            });
        },
        onApprove: function(data, actions) {
            const msg = document.getElementById('pay-msg');
            msg.textContent = 'Verifying PayPal payment…';
            msg.style.display = 'block';
            msg.style.color = '#7C5CFF';

            return actions.order.capture().then(function(details) {
                return fetch('/api/paypal/capture-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderID: data.orderID,
                        payerID: data.payerID,
                        payerName: details && details.payer && details.payer.name ? details.payer.name.given_name : ''
                    })
                }).then(r => r.json()).then(res => {
                    if (res.success) {
                        msg.textContent = '🎉 Payment Successful! Your PRO Access is now UNLOCKED!';
                        msg.style.color = '#16a34a';
                        setTimeout(() => {
                            window.location.href = '/browse.php';
                        }, 1200);
                    } else {
                        msg.textContent = res.error || 'Activation failed. Please contact admin.';
                        msg.style.color = '#dc2626';
                    }
                });
            });
        },
        onError: function(err) {
            console.error('PayPal Error:', err);
            const msg = document.getElementById('pay-msg');
            msg.textContent = 'PayPal window closed or payment cancelled. You can also purchase via WhatsApp.';
            msg.style.display = 'block';
            msg.style.color = '#dc2626';
        }
    }).render('#paypal-button-container');
} else {
    const loader = document.getElementById('paypal-loader');
    if (loader) {
        loader.innerHTML = '<span style="color:#b91c1c; font-size:12px;">⚠️ PayPal SDK loading. You can also use Option 2: WhatsApp to purchase instantly!</span>';
    }
}

function activateDemoProSubscription() {
    const btn = document.getElementById('pay-btn');
    const msg = document.getElementById('pay-msg');
    btn.disabled = true;
    btn.textContent = 'Activating Pro Demo…';

    fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    }).then(r => r.json()).then(res => {
        if (res.success) {
            msg.textContent = '🎉 Test Activation Successful! Pro Access Activated.';
            msg.style.display = 'block';
            msg.style.color = '#16a34a';
            setTimeout(() => {
                window.location.href = '/browse.php';
            }, 1000);
        } else {
            msg.textContent = res.error || 'Payment failed.';
            msg.style.display = 'block';
            msg.style.color = '#dc2626';
            btn.disabled = false;
            btn.textContent = '⚡ Instant Test Mode Activation';
        }
    }).catch(err => {
        console.error(err);
        msg.textContent = 'Connection error.';
        msg.style.display = 'block';
        btn.disabled = false;
        btn.textContent = '⚡ Instant Test Mode Activation';
    });
}
</script>
<% } %>

<%- include('partials/footer') %>
