<%- include('partials/header') %>

<div class="auth-box">
    <div class="auth-card">
        <h1>Welcome Back</h1>
        
        <% if (error) { %>
            <div style="background:#fee2e2;color:#dc2626;padding:10px 14px;border-radius:10px;font-size:14px;margin-bottom:16px;">
                <%= error %>
            </div>
        <% } %>

        <form method="post" action="/login.php">
            <input type="hidden" name="next" value="<%= nextUrl %>">
            <div class="fld">
                <label>Email</label>
                <input type="email" name="email" required placeholder="you@example.com" value="<%= email || '' %>">
            </div>
            <div class="fld">
                <label>Password</label>
                <input type="password" name="password" required placeholder="••••••••">
            </div>
            <button type="submit" class="btn btn-primary btn-block">Login with Password</button>
        </form>

        <!-- Quick 1-Click Demo Logins for Pair Programming & Testing -->
        <div style="margin-top:24px;padding-top:18px;border-top:1px dashed var(--border);text-align:center;">
            <p style="font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:600;">QUICK 1-CLICK DEMO ACCOUNTS:</p>
            <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
                <button type="button" class="btn btn-sm btn-outline" onclick="quickFill('admin@promptsclub.com', 'admin123')">👑 Admin</button>
                <button type="button" class="btn btn-sm btn-outline" onclick="quickFill('pro@example.com', 'user123')">⭐ Pro Member</button>
                <button type="button" class="btn btn-sm btn-outline" onclick="quickFill('free@example.com', 'user123')">🎁 Free User</button>
            </div>
        </div>

        <p class="auth-alt" style="margin-top:20px;">
            Don't have an account? <a href="/register.php<%= nextUrl ? '?next=' + encodeURIComponent(nextUrl) : '' %>">Create account</a>
        </p>
    </div>
</div>

<script>
function quickFill(email, pass) {
    document.querySelector('input[name="email"]').value = email;
    document.querySelector('input[name="password"]').value = pass;
    document.querySelector('form').submit();
}
</script>

<%- include('partials/footer') %>
