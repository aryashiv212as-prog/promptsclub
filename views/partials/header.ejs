<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
<meta name="theme-color" content="#6366F1">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="PromptsClub">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="/manifest.json">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — PromptsClub' : 'PromptsClub — Viral AI Video Prompts Library' %></title>
<meta name="description" content="PromptsClub — Viral AI video prompts for Facebook Reels, YouTube Shorts, Instagram & TikTok. Works with Kling AI, Seedance, Veo, Luma & Runway. New prompts every week.">
<link rel="icon" type="image/png" href="/assets/img/logo.png">
<link rel="apple-touch-icon" href="/assets/img/logo.png">
<meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' — PromptsClub' : 'PromptsClub — Viral AI Video Prompts' %>">
<meta property="og:description" content="Viral AI video prompts for Reels, Shorts & TikTok — works with any AI video tool on promptsclub.com.">
<meta property="og:image" content="/assets/img/cover.jpg">
<meta property="og:type" content="website">
<link rel="stylesheet" href="/assets/css/style.css?v=22">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">

<style>
/* Enhanced Clone Additions */
.badge-pro {
    background: linear-gradient(135deg, #7C5CFF, #E056FD);
    color: #fff;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.badge-free {
    background: var(--green-light);
    color: var(--green);
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}
.toast-notice {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #17151F;
    color: #fff;
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    z-index: 9999;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: slideUp 0.3s ease;
}
@keyframes slideUp {
    from { transform: translateY(30px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
.prompt-box-unlocked {
    background: transparent;
    border-radius: var(--radius);
    padding: 0;
    margin-top: 24px;
}
.prompt-box-unlocked pre,
.prompt-content,
#prompt-content {
    background: #FFFFFF !important;
    color: #000000 !important;
    padding: 28px 30px !important;
    border-radius: var(--radius, 16px) !important;
    white-space: pre-wrap !important;
    word-break: break-word !important;
    word-wrap: break-word !important;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 15px !important;
    line-height: 1.85 !important;
    max-height: none !important;
    overflow-y: visible !important;
    border: 1.5px solid var(--border, #E9E7F0) !important;
    box-shadow: 0 1px 4px rgba(23, 21, 31, 0.05) !important;
    font-weight: 450 !important;
}
.copy-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 10px;
}
.prompt-actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
}
.tool-tag {
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    display: inline-block;
    margin-right: 6px;
    margin-bottom: 6px;
}
.user-menu-badge {
    background: var(--primary-light);
    color: var(--primary);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all .15s;
}
.user-menu-badge:hover {
    background: var(--primary);
    color: #fff;
}
.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 13, 25, 0.65);
    backdrop-filter: blur(4px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.modal-overlay.open {
    display: flex;
}
.modal-content {
    background: #fff;
    border-radius: var(--radius);
    max-width: 500px;
    width: 100%;
    padding: 32px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    position: relative;
    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes modalPop {
    from { transform: scale(0.92); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}
</style>
</head>
<body>
<header class="site-header">
    <div class="container header-inner">
        <a href="/" class="brand">
            <span class="brand-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <defs>
                        <linearGradient id="pClubGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#06B6D4" />
                            <stop offset="50%" stop-color="#6366F1" />
                            <stop offset="100%" stop-color="#A855F7" />
                        </linearGradient>
                    </defs>
                    <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="url(#pClubGrad)" />
                    <path d="M2 17L12 22L22 17" stroke="url(#pClubGrad)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M2 12L12 17L22 12" stroke="url(#pClubGrad)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span class="brand-text">Prompts<span class="brand-accent">Club</span></span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle-cb">
        <label for="nav-toggle" class="nav-toggle">☰</label>
        <nav class="main-nav">
            <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
            <a href="/browse.php" class="<%= currentPath.startsWith('/browse') ? 'active' : '' %>">All Prompts</a>
            <a href="/pricing.php" class="<%= currentPath.startsWith('/pricing') ? 'active' : '' %>">Join Community</a>
            
            <% if (currentUser) { %>
                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin" class="nav-admin" style="font-weight:700;">⚙️ Admin</a>
                <% } %>
                <a href="/account.php" class="user-menu-badge">
                    <span>👤 <%= currentUser.name.split(' ')[0] %></span>
                    <% if (currentUser.is_pro) { %>
                        <span style="font-size:11px;background:#7C5CFF;color:#fff;padding:2px 7px;border-radius:10px;">⭐ PRO</span>
                    <% } else { %>
                        <span style="font-size:11px;background:#e2e8f0;color:#475569;padding:2px 7px;border-radius:10px;">FREE</span>
                    <% } %>
                </a>
                <a href="/logout.php" style="color:var(--muted);font-size:13px;">Logout</a>
            <% } else { %>
                <a href="/login.php">Login</a>
                <a href="/register.php" class="nav-btn">Get Started</a>
            <% } %>
        </nav>
    </div>
</header>
<main>
